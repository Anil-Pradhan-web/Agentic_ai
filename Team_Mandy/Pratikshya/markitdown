import os
from markitdown import MarkItDown

def main():
    # Define directories relative to this script
    base_dir = os.path.dirname(os.path.abspath(__file__))
    input_dir = os.path.join(base_dir, "documents")
    output_dir = os.path.join(base_dir, "markdown")

    # Ensure directories exist
    if not os.path.exists(input_dir):
        print(f"Error: Input directory '{input_dir}' does not exist.")
        return

    os.makedirs(output_dir, exist_ok=True)

    # Initialize MarkItDown converter
    markitdown = MarkItDown()

    # Get all files from input_dir
    files = [f for f in os.listdir(input_dir) if os.path.isfile(os.path.join(input_dir, f))]
    
    if not files:
        print("No files found in the documents folder to convert.")
        return

    print(f"Found {len(files)} file(s) to convert.")

    for filename in files:
        input_path = os.path.join(input_dir, filename)
                # Determine output filename (replace original extension with .md)
        name_without_ext, _ = os.path.splitext(filename)
        output_filename = f"{name_without_ext}.md"
        output_path = os.path.join(output_dir, output_filename)

        print(f"Converting '{filename}' to Markdown...")
        try:
            result = markitdown.convert(input_path)
            # Write markdown content with UTF-8 encoding
            with open(output_path, "w", encoding="utf-8") as f:
                f.write(result.text_content)
            print(f"Successfully converted and saved to '{os.path.relpath(output_path, base_dir)}'")
        except Exception as e:
            print(f"Failed to convert '{filename}': {e}")

if __name__ == "__main__":
    main()
