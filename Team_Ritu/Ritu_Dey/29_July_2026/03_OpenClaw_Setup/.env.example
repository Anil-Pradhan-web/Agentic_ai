# OpenClaw — environment configuration template
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Model provider ---
MODEL_PROVIDER=anthropic          # anthropic | openai | local
MODEL_NAME=claude-sonnet-5
MODEL_API_KEY=your_api_key_here   # static API key (see 02_OAuth_vs_APIKey_Pros_Cons.md for tradeoffs)

# --- OAuth (only if the provider/integration uses it instead of a static key) ---
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/callback

# --- Service ---
PORT=8000
LOG_LEVEL=info

# --- Agent permissions (principle of least privilege) ---
ALLOW_TOOL_BROWSER=true
ALLOW_TOOL_TERMINAL=false
ALLOW_TOOL_FILE_EDIT=false

# --- Storage ---
DATA_DIR=./data
